# Public Supabase Auth config for the website.
# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Waitlist questionnaire config. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Generate a stable value with: openssl rand -hex 32
WAITLIST_PROFILE_SECRET=

# Fovea backend base URL. Local backend usually runs on http://localhost:8080.
NEXT_PUBLIC_FOVEA_API_BASE_URL=http://localhost:8080
